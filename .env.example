# ProofPilot Environment Configuration

# ── LLM Provider Configuration ────────────────────────────────────────────────
# LLM_PROVIDER: "groq" (default, fastest), "gemini", or "local" (zero-cost fallback)
LLM_PROVIDER=groq

# Groq Cloud API Key — Get free key at https://console.groq.com
# Model: llama-3.3-70b-versatile (~700 tokens/sec, 128k context)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key — Get free key at https://aistudio.google.com
# Used as secondary fallback when LLM_PROVIDER=gemini or Groq fails
GEMINI_API_KEY=your_gemini_api_key_here

# ── Razorpay Integration ──────────────────────────────────────────────────────
# Razorpay Webhook Secret for HMAC-SHA256 signature verification
WEBHOOK_SECRET=whsec_proofpilot_simulated_key_99x

# Webhook Authentication Enforcement (true/false)
ENFORCE_WEBHOOK_AUTH=true

# API Key for securing /disputes/ endpoints (Optional in local dev; required in production)
PROOFPILOT_API_KEY=proofpilot_sec_key_demo_2026

# ── Server & Security Settings ───────────────────────────────────────────────
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501

